<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="top"
        android:background="@drawable/ltv_controller_top_gradient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="178dp"
        android:layout_gravity="bottom"
        android:background="@drawable/ltv_controller_bottom_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ltv_controller_logo_bg"
            android:padding="5dp">
            <ImageView
                android:id="@+id/ltv_channel_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Channel logo"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ltv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:text="LiveTGTV"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ltv_channel_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="LIVE TELEVISION"
                android:textColor="#AFC3D8"
                android:textSize="10sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/ltv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ltv_controller_live_bg"
            android:drawablePadding="5dp"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ltv_channels"
            android:layout_width="42dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ltv_controller_chip"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="☷"
            android:textColor="#E7F8FF"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ltv_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ltv_controller_round_button"
            android:contentDescription="Previous channel"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/exo_rew"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/ltv_controller_round_button"
            android:contentDescription="Rewind"
            android:src="@android:drawable/ic_media_rew"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/exo_play"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/ltv_player_play_bg"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play"
            android:tint="#07131D" />

        <ImageButton
            android:id="@+id/exo_pause"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/ltv_player_play_bg"
            android:contentDescription="Pause"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#07131D" />

        <ImageButton
            android:id="@+id/ltv_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/ltv_controller_round_button"
            android:contentDescription="Next channel"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/ltv_controller_bottom_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ltv_program_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="NOW PLAYING · LIVE BROADCAST"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ltv_program_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ON AIR"
                android:textColor="#67E8F9"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/ltv_epg_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="#22D3EE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="7dp"
                android:text="LIVE"
                android:textColor="#DCE8F5"
                android:textSize="10sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:text="LIVE"
                android:textColor="#DCE8F5"
                android:textSize="10sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="3dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/ltv_mute"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="♫  Volume"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="♫  Audio"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="HD  Quality"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_subtitles"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="CC  Subtitles"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="1×  Speed"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_fit"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="▣  Fit screen"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_pip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="▣  PiP"
                    android:textAllCaps="false"
                    android:textColor="#E5F3FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/ltv_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/ltv_controller_chip_active"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="⛶  Fullscreen"
                    android:textAllCaps="false"
                    android:textColor="#07131D"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>