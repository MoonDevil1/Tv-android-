<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="#B8000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ltv_channel_logo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="#33202B3B"
            android:contentDescription="Channel logo"
            android:padding="5dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ltv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="LiveTGTV"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ltv_channel_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Live television"
                android:textColor="#BFC9D8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ltv_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D92B3548"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ltv_previous"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="#66000000"
            android:contentDescription="Previous channel"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/exo_rew"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rewind"
            android:src="@android:drawable/ic_media_rew"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/exo_play"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/ltv_player_play_bg"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play"
            android:tint="#07131D" />

        <ImageButton
            android:id="@+id/exo_pause"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/ltv_player_play_bg"
            android:contentDescription="Pause"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#07131D" />

        <ImageButton
            android:id="@+id/ltv_next"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="18dp"
            android:background="#66000000"
            android:contentDescription="Next channel"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_gravity="bottom"
        android:background="#D9000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ltv_program_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now playing"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ltv_program_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="#67E8F9"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ltv_epg_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="#334155" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button android:id="@+id/ltv_rewind" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="−10s" android:textSize="10sp" />
                <Button android:id="@+id/ltv_forward" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="+10s" android:textSize="10sp" />
                <Button android:id="@+id/ltv_mute" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Volume" android:textSize="10sp" />
                <Button android:id="@+id/ltv_channels" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Channels" android:textSize="10sp" />
                <Button android:id="@+id/ltv_audio" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Audio" android:textSize="10sp" />
                <Button android:id="@+id/ltv_quality" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Quality" android:textSize="10sp" />
                <Button android:id="@+id/ltv_subtitles" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Subtitles" android:textSize="10sp" />
                <Button android:id="@+id/ltv_speed" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Speed 1×" android:textSize="10sp" />
                <Button android:id="@+id/ltv_pip" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="PiP" android:textSize="10sp" />
                <Button android:id="@+id/ltv_fit" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Fit" android:textSize="10sp" />
                <Button android:id="@+id/ltv_fullscreen" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="Fullscreen" android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>